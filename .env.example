PORT=3000

# Gere um valor aleatorio forte (32+ caracteres). Nunca reaproveite o
# valor de exemplo abaixo em producao.
JWT_SECRET=troque_por_um_valor_aleatorio_bem_grande

# Credenciais do usuario admin criado automaticamente no primeiro boot.
ADMIN_USER=admin
ADMIN_PASSWORD=troque_esta_senha

# Opcional: restringe quem pode chamar a API por CORS.
# Deixe vazio em desenvolvimento; em producao, defina para o dominio
# do seu frontend (ex: https://seu-app.onrender.com).
CORS_ORIGIN=

# ---------------------------------------------------------------
# BANCO DE DADOS (Postgres / Supabase)
# ---------------------------------------------------------------
# Use UMA das duas opcoes abaixo (nao precisa das duas).
#
# Opcao A) Uma unica connection string.
# ATENCAO: se a senha do banco tiver caracteres especiais (# @ % / : ?)
# ela PRECISA estar url-encoded, senao a conexao falha de forma confusa
# ("password authentication failed"). Prefira a Opcao B se a senha tiver
# qualquer caractere que nao seja letra/numero.
# DATABASE_URL=postgresql://usuario:senha@host:porta/postgres

# Opcao B) Campos separados (recomendado — evita problema de encoding).
# No Supabase: Project Settings > Database > Connection parameters.
# Use o host do "Transaction pooler" (nao o "Direct connection" — o
# direct connection e IPv6-only e falha em redes sem suporte a IPv6).
PGHOST=aws-1-us-west-2.pooler.supabase.com
PGPORT=6543
PGUSER=postgres.seu-projeto-ref
PGPASSWORD=sua_senha_do_banco
PGDATABASE=postgres

# ---------------------------------------------------------------
# WHATSAPP (Baileys) — módulo financeiro de entregadores
# ---------------------------------------------------------------
# false desliga o módulo inteiro (o resto do ERP funciona normalmente).
WHATSAPP_HABILITADO=true

# Nome exato do grupo que recebe os comprovantes.
WHATSAPP_GRUPO_NOME=Açaí clts

# Chave PIX mostrada na tela de pagamento do entregador.
PIX_CHAVE=37.937.310/0001-47

# Quando o lembrete semanal roda (formato cron), sempre no fuso
# America/Sao_Paulo. Padrao: toda quarta-feira as 9h.
# LEMBRETE_CRON=0 9 * * 3
