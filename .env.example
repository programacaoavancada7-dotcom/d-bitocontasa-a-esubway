PORT=3000

# Gere um valor aleatorio forte (32+ caracteres). Nunca reaproveite o
# valor de exemplo abaixo em producao.
JWT_SECRET=troque_por_um_valor_aleatorio_bem_grande

# Credenciais do usuario admin criado automaticamente no primeiro boot.
ADMIN_USER=admin
ADMIN_PASSWORD=troque_esta_senha

# Opcional: restringe quem pode chamar a API por CORS.
# Deixe vazio em desenvolvimento; em producao, defina para o dominio
# do seu frontend (ex: https://seu-app.onrender.com).
CORS_ORIGIN=
